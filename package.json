{
  "name": "spiel-des-lebens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "test:engine": "cargo test -p life-engine",
    "build:linux": "tauri build --bundles appimage",
    "build:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle",
    "build:windows-native": "tauri build --no-bundle",
    "release": "bash scripts/package-release.sh",
    "build:wasm": "bash scripts/build-wasm.sh",
    "dev:web": "npm run build:wasm && vite --mode web",
    "build:web": "npm run build:wasm && tsc -b && vite build --mode web",
    "preview:web": "vite preview --mode web"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
