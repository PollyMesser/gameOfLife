{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spiel-des-Lebens",
  "mainBinaryName": "spiel-des-lebens",
  "version": "0.1.0",
  "identifier": "de.clandy.spieldeslebens",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spiel des Lebens – Regel-Labor",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Education",
    "shortDescription": "Spiel des Lebens mit eigenen Regeln",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}